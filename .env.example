# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection
# If local MongoDB is running: mongodb://localhost:27017/green_node
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/green_node?retryWrites=true&w=majority
# If left empty or unable to connect, will automatically fallback to in-memory MongoDB for easy zero-setup testing
MONGODB_URI=mongodb://localhost:27017/green_node

# CORS Origins (comma separated or * for all)
CORS_ORIGIN=*
